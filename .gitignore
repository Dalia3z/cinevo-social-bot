# ============================================================================
# Cinevo AI Social Media Engagement Bot - .gitignore
# ============================================================================

# Secrets - NEVER commit your real .env file
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# Runtime database & logs
*.db
*.db-wal
*.db-shm
logs/
quora_queue/
# Short-form content queue (runtime artifact, regenerated locally)
content_queue.db
content_queue.db-wal
content_queue.db-shm

# Rendered short videos (large binaries; uploaded as CI artifacts instead)
content_videos/
*.mp4

# VPS trailer pipeline (large binaries; never commit these)
trailer_clips/
trailer_output/
.compose_work/
*.mp3
*.m4a
*.wav

# PM2
pm2-*.log
*.pid

# OS
.DS_Store
Thumbs.db

# Local debug dumps (never commit these)
*_dump.txt
reply*.txt
thread_dump.txt
