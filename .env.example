# ============================================================================
# Cinevo AI Social Media Engagement Bot - Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
# NEVER commit the real `.env` file to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# MASTER SWITCH
# ---------------------------------------------------------------------------
# Set to false to disable the whole bot without deleting config.
BOT_ENABLED=true

# Comma-separated list of platforms to run.
# Options: youtube, meta, tiktok, quora
ACTIVE_PLATFORMS=youtube,meta

# ---------------------------------------------------------------------------
# DEEPSEEK AI
# ---------------------------------------------------------------------------
# Your DeepSeek API key (https://platform.deepseek.com).
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=120
DEEPSEEK_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# BRAND / WEBSITE (injected naturally into replies)
# ---------------------------------------------------------------------------
WEBSITE_URL=https://cinevoapp.com
BRAND_NAME=Cinevo
# How often (0.0 - 1.0) the website link appears in a reply.
# 1.0 = ALWAYS include the link (default). 0.8 = 80% of replies, 0.0 = never.
WEBSITE_LINK_PROBABILITY=1.0
# Warm-up: for the first N replies the bot posts GENUINE comments with NO
# website link. YouTube holds replies from brand-new channels for review when
# they immediately post promotional links, so we build trust first. After N
# replies the link is included normally. Set to 0 to disable warm-up.
WARMUP_REPLIES=20

# ---------------------------------------------------------------------------
# TARGET DISCOVERY (auto-collected movie/TV IDs)
# ---------------------------------------------------------------------------
# The bot reads discovered targets from this JSON file (see targets.json),
# which is populated by running:  python discover_targets.py --all --max 10000
# Keeping IDs in a JSON file (not .env) avoids bloating the .env with 10k IDs.
TARGETS_FILE=targets.json
# Optional cap on how many discovered targets the bot monitors per platform.
# 0 (default) = use ALL discovered targets.
MAX_TARGETS_PER_PLATFORM=0

# ---------------------------------------------------------------------------
# YOUTUBE (YouTube Data API v3)
# ---------------------------------------------------------------------------
YOUTUBE_ENABLED=true
# Google Cloud API key (for reading comments).
YOUTUBE_API_KEY=your-youtube-api-key
# OAuth 2.0 access token required to POST replies (comments.insert).
# Scope needed: https://www.googleapis.com/auth/youtube.force-ssl
# NOTE: an access token EXPIRES after ~1 hour. For unattended runs (cron),
# set the refresh-token trio below instead so the bot auto-renews the token.
YOUTUBE_OAUTH_TOKEN=your-oauth-access-token
# Long-lived refresh token + OAuth client credentials (RECOMMENDED for cron).
# When all three are set, the bot exchanges the refresh token for a fresh
# access token on every run, so posting never breaks due to expiry.
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Comma-separated list of Shorts video IDs to monitor.
# NOTE: discovered IDs live in targets.json; this is an optional manual override.
YOUTUBE_VIDEO_IDS=
# Comma-separated list of channel IDs to monitor (their recent uploads).
# NOTE: discovered channel IDs live in targets.json; optional manual override.
YOUTUBE_CHANNEL_IDS=

# ---------------------------------------------------------------------------
# META (Facebook Pages + Instagram Business) - Graph API
# ---------------------------------------------------------------------------
META_ENABLED=true
# Long-lived Page access token with permissions:
#   pages_manage_posts, pages_read_engagement,
#   instagram_basic, instagram_manage_comments
META_ACCESS_TOKEN=your-meta-page-access-token
META_API_VERSION=v19.0
# Comma-separated Facebook Page IDs.
# NOTE: discovered page IDs live in targets.json; optional manual override.
FACEBOOK_PAGE_IDS=
# Comma-separated Instagram Business Account IDs.
# NOTE: discovered Instagram IDs live in targets.json; optional manual override.
INSTAGRAM_BUSINESS_IDS=

# ---------------------------------------------------------------------------
# TIKTOK
# ---------------------------------------------------------------------------
# NOTE: TikTok's public comment API is not generally available. Leave disabled
# unless your app is approved for the relevant endpoints.
TIKTOK_ENABLED=false
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
# Comma-separated TikTok video IDs to monitor.
TIKTOK_VIDEO_IDS=
# HIGH RISK browser automation (requires selenium). Disabled by default.
TIKTOK_BROWSER_AUTOMATION=false

# ---------------------------------------------------------------------------
# QUORA
# ---------------------------------------------------------------------------
# NOTE: Quora has no public API. Default mode generates answers and queues
# them for MANUAL review (safe). Browser automation is opt-in and high risk.
QUORA_ENABLED=false
# Comma-separated topics/keywords to monitor (e.g. movies, series).
QUORA_TOPICS=movies,series
QUORA_USERNAME=
QUORA_PASSWORD=
# HIGH RISK browser automation (requires selenium). Disabled by default.
QUORA_BROWSER_AUTOMATION=false

# ---------------------------------------------------------------------------
# ANTI-BAN / RATE LIMITING
# ---------------------------------------------------------------------------
# Random delay (seconds) between consecutive replies. Default 60-150 (1-2.5 min).
# Keep this SHORT enough that several replies fit inside MAX_RUNTIME_SECONDS.
MIN_DELAY_SECONDS=60
MAX_DELAY_SECONDS=150
# How often (seconds) the main loop polls each platform.
POLL_INTERVAL_SECONDS=300
# Max comments fetched per platform per cycle.
MAX_COMMENTS_PER_CYCLE=20
# Max comments taken from a SINGLE video per cycle. Keeps replies spread
# across many videos instead of hammering one video (default 2).
MAX_COMMENTS_PER_VIDEO=2
# Hard runtime budget (seconds) for a single `--once` cycle. The bot stops
# starting new replies once this is reached and exits CLEANLY, so GitHub
# Actions' `timeout-minutes` never kills it mid-run ("operation was canceled").
# Default 780s (13 min) leaves ~2 min headroom under a 15-min job limit.
MAX_RUNTIME_SECONDS=780

# ---------------------------------------------------------------------------
# SHORT-FORM CONTENT SYSTEM (TikTok / YouTube Shorts)
# ---------------------------------------------------------------------------
# IMPORTANT: This subsystem is COMPLETELY SEPARATE from the comment-reply bot.
# It only GENERATES text (hooks / scripts / captions / hashtags) via
# `python content_cli.py ...` and NEVER posts anything automatically.
# It cannot affect the YouTube engagement loop.
#
# Language used for generated scripts and captions.
CONTENT_LANGUAGE=English
# How many posts per day the planner schedules (spread across time slots).
CONTENT_POSTS_PER_DAY=3
# Max tokens for a single AI generation (scripts are short; 1200 is plenty).
CONTENT_MAX_TOKENS=1200
# Creativity of the generator (0.0 = strict, 1.0 = very creative). 0.9 recommended.
CONTENT_TEMPERATURE=0.9

# ---------------------------------------------------------------------------
# SHORT-FORM VIDEO + AUTO-PUBLISH (TikTok / YouTube Shorts)
# ---------------------------------------------------------------------------
# MASTER KILL-SWITCH for the video/auto-publish subsystem ONLY.
# false = the whole video pipeline is disabled (the reply bot is unaffected).
# Set to true to enable video generation + (optionally) auto-publishing.
CONTENT_ENABLED=false
# SECOND SAFETY GATE. Even when CONTENT_ENABLED=true, nothing is uploaded
# unless this is ALSO true. Leave false to render videos without publishing.
CONTENT_AUTO_PUBLISH=false
# Hard cap on how many videos may be PUBLISHED per day (default 1).
CONTENT_DAILY_PUBLISH_LIMIT=1
# YouTube privacy for auto-published videos: public | unlisted | private.
# `unlisted` (default) lets you review before making it public.
CONTENT_PRIVACY=unlisted
# YouTube category id (24 = Entertainment).
CONTENT_CATEGORY_ID=24
# Where rendered MP4 files are written (git-ignored).
CONTENT_VIDEO_DIR=content_videos
# Optional royalty-free background music file. Empty = no music.
CONTENT_MUSIC_PATH=
# AI voiceover via edge-tts (free). Set false for silent videos.
CONTENT_ENABLE_VOICE=true
# edge-tts voice name (run `edge-tts --list-voices` for options).
CONTENT_VOICE=en-US-AriaNeural

# ---------------------------------------------------------------------------
# VPS TRAILER PIPELINE (real footage from official YouTube trailers)
# ---------------------------------------------------------------------------
# This pipeline is meant to run on a VPS, NOT on GitHub Actions. It downloads
# official trailers with yt-dlp, cuts short clips, transforms them (Ken Burns,
# colour grade, mirror, speed ramp) and composes a vertical Short.
#
# !! COPYRIGHT WARNING !!
# Re-using trailer footage is NOT risk-free. YouTube's Content ID is automated
# and may claim or block the upload. The transformations reduce the chance of a
# match but do NOT eliminate it. Keep CONTENT_PRIVACY=unlisted until you have
# reviewed several uploads. See README for the full discussion.
#
# MASTER KILL-SWITCH for the trailer pipeline ONLY.
TRAILER_ENABLED=false
# Where downloaded source trailers are cached (git-ignored).
TRAILER_CLIPS_DIR=trailer_clips
# Where the cut/transformed clips are written (git-ignored).
TRAILER_OUTPUT_DIR=trailer_output
# Timeout (seconds) for a single yt-dlp download.
TRAILER_DOWNLOAD_TIMEOUT=600
# Length (seconds) of each cut clip. Shorts work best with 2-4s cuts.
TRAILER_CLIP_SECONDS=3.5
# How many clips to cut from a single trailer.
TRAILER_CLIPS_PER_VIDEO=5
# How many trailers to download per run.
TRAILER_DOWNLOADS_PER_RUN=2
# Comma separated titles to build videos around (optional).
# When empty the generic content planner pool is used.
TRAILER_TITLES=
# Comma separated trailer URLs to use instead of searching YouTube (optional).
TRAILER_SOURCE_URLS=
# Transformation toggles. The more the footage is transformed, the weaker a
# Content ID match tends to be. Mirror and speed-ramp are the most aggressive.
TRAILER_KEN_BURNS=true
TRAILER_COLOR_GRADE=true
TRAILER_MIRROR=false
TRAILER_SPEED_RAMP=false
# Optional royalty-free music bed for the composed video.
TRAILER_MUSIC_PATH=
# Append the source trailer URL to the description (honest attribution).
TRAILER_ATTRIBUTION=true

# ---------------------------------------------------------------------------
# DATABASE & LOGGING
# ---------------------------------------------------------------------------
DB_PATH=bot_state.db
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
