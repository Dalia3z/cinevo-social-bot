# ============================================================================
# Cinevo AI Social Media Engagement Bot - Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
# NEVER commit the real `.env` file to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# MASTER SWITCH
# ---------------------------------------------------------------------------
# Set to false to disable the whole bot without deleting config.
BOT_ENABLED=true

# Comma-separated list of platforms to run.
# Options: youtube, meta, tiktok, quora
ACTIVE_PLATFORMS=youtube,meta

# ---------------------------------------------------------------------------
# DEEPSEEK AI
# ---------------------------------------------------------------------------
# Your DeepSeek API key (https://platform.deepseek.com).
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=120
DEEPSEEK_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# BRAND / WEBSITE (injected naturally into replies)
# ---------------------------------------------------------------------------
WEBSITE_URL=https://cinevoapp.com
BRAND_NAME=Cinevo

# ---------------------------------------------------------------------------
# YOUTUBE (YouTube Data API v3)
# ---------------------------------------------------------------------------
YOUTUBE_ENABLED=true
# Google Cloud API key (for reading comments).
YOUTUBE_API_KEY=your-youtube-api-key
# OAuth 2.0 access token required to POST replies (comments.insert).
# Scope needed: https://www.googleapis.com/auth/youtube.force-ssl
YOUTUBE_OAUTH_TOKEN=your-oauth-access-token
# Comma-separated list of Shorts video IDs to monitor.
YOUTUBE_VIDEO_IDS=VIDEO_ID_1,VIDEO_ID_2

# ---------------------------------------------------------------------------
# META (Facebook Pages + Instagram Business) - Graph API
# ---------------------------------------------------------------------------
META_ENABLED=true
# Long-lived Page access token with permissions:
#   pages_manage_posts, pages_read_engagement,
#   instagram_basic, instagram_manage_comments
META_ACCESS_TOKEN=your-meta-page-access-token
META_API_VERSION=v19.0
# Comma-separated Facebook Page IDs.
FACEBOOK_PAGE_IDS=PAGE_ID_1,PAGE_ID_2
# Comma-separated Instagram Business Account IDs.
INSTAGRAM_BUSINESS_IDS=IG_ID_1,IG_ID_2

# ---------------------------------------------------------------------------
# TIKTOK
# ---------------------------------------------------------------------------
# NOTE: TikTok's public comment API is not generally available. Leave disabled
# unless your app is approved for the relevant endpoints.
TIKTOK_ENABLED=false
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
# Comma-separated TikTok video IDs to monitor.
TIKTOK_VIDEO_IDS=
# HIGH RISK browser automation (requires selenium). Disabled by default.
TIKTOK_BROWSER_AUTOMATION=false

# ---------------------------------------------------------------------------
# QUORA
# ---------------------------------------------------------------------------
# NOTE: Quora has no public API. Default mode generates answers and queues
# them for MANUAL review (safe). Browser automation is opt-in and high risk.
QUORA_ENABLED=false
# Comma-separated topics/keywords to monitor (e.g. movies, series).
QUORA_TOPICS=movies,series
QUORA_USERNAME=
QUORA_PASSWORD=
# HIGH RISK browser automation (requires selenium). Disabled by default.
QUORA_BROWSER_AUTOMATION=false

# ---------------------------------------------------------------------------
# ANTI-BAN / RATE LIMITING
# ---------------------------------------------------------------------------
# Random delay (seconds) between consecutive replies. Default 180-420 (3-7 min).
MIN_DELAY_SECONDS=180
MAX_DELAY_SECONDS=420
# How often (seconds) the main loop polls each platform.
POLL_INTERVAL_SECONDS=300
# Max comments fetched per platform per cycle.
MAX_COMMENTS_PER_CYCLE=20

# ---------------------------------------------------------------------------
# DATABASE & LOGGING
# ---------------------------------------------------------------------------
DB_PATH=bot_state.db
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
